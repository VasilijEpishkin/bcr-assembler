.env

# OS/editor noise
.DS_Store
**/.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Large raw sequencing data / local downloads
# FASTQ lives on OneQ/ENA, not in git.
data/
raw/
**/*.fastq
**/*.fastq.gz
**/*.fq
**/*.fq.gz

# Large annotation tables live on OneQ/local disk; track lightweight manifests/summaries instead.
results/**/igblast/*_igblast.tsv
results/**/igblast/*.bak

# Local OneQ/OpenScience state, credentials, staging, logs
.oneq-home/
.oneq-results-test/
.oneq-stage-*/
.openscience/
oneq_known_hosts
oneq_keypair_*/
*.stdout.log
remote_oneq_*.sh
run_oneq_*.py
tmp_run_oneq_*.py

# Macaque results removed from repo; raw dataset stays on OneQ only
results/PRJNA1247978/

# Local Hermes plan / session artifacts
.hermes/

# Python/script caches
scripts/__pycache__/

# Local working copy of the mouse fastp branch; published as results/ERP003950 (see docs/notebook_layout.md)
results/ERP003950_fastp_q30_u40/

# Light-chain mouse PRJNA1226555: only the selected branch (fastp q30 u40 min250) is published, under canonical names;
# other preprocessing branches stay local
results/PRJNA1226555/notebooks/*_min200.ipynb
results/PRJNA1226555/notebooks/*_fastp_min250.ipynb
results/PRJNA1226555/branches/

# Не публикуются: логи стадий и старый QC сырых ридов овцы (заменён raw/)
results/*/*/logs/
results/PRJNA900592/qc_raw/
results/evaluation/
